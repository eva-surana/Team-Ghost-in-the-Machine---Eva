# ============================================================
# Aletheon Backend — Environment Configuration
# OFFLINE BUILD: no API keys, no cloud endpoints.
# All values are LOCAL PATHS and operational flags.
# ============================================================

# --- Local model / artifact paths (relative to project root) ---
ENTAILMENT_CLASSIFIER_PATH=./models/entailment_classifier.pkl
CORPUS_INDEX_PATH=./models/corpus_index.pkl
TESSERACT_DATA_PATH=./models/tessdata

# --- Storage paths ---
SQLITE_DB_PATH=./data/aletheon.db
SPARSE_VECTORS_DIR=./data/sparse_vectors
DOC_VECTORIZERS_DIR=./data/doc_vectorizers
CORPUS_TEXT_DIR=./corpus

# --- Offline enforcement flags ---
OFFLINE_MODE=true
PRETRAINED_WEIGHTS_USED=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# --- Verification & Contradiction thresholds ---
ENTAILMENT_VERIFIED_THRESHOLD=0.60
ENTAILMENT_PARTIAL_THRESHOLD=0.30
CONTRADICTION_SIMILARITY_THRESHOLD=0.25
CONTRADICTION_CONFIDENCE_THRESHOLD=0.35
CONTRADICTION_MAX_PAIRS=50

# --- Recommendation settings ---
RECOMMENDATION_TOP_K=5
MISSING_CITATION_TOP_K=5
ENABLE_ONLINE_RECOMMENDATIONS=false
RECOMMENDATION_CACHE_TTL_HOURS=6

# --- Server & Security settings ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
MAX_UPLOAD_BYTES=52428800
MAX_QUESTION_CHARS=500
LOG_FORMAT=text
LOG_LEVEL=INFO
DOCS_ENABLED=true
